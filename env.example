# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# File Upload
MAX_FILE_SIZE="10485760" # 10MB
UPLOAD_DIR="./uploads"

# Provisioning (secure admin account creation API)
PROVISION_TOKEN="set-a-strong-random-token-here"

# Stripe Payment Integration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Self-service signup (registration + Stripe checkout). Off unless "true".
PUBLIC_SIGNUP_ENABLED="false"

# Stripe test-mode Price id of the RI&E yearly subscription (price_...). Required for checkout.
STRIPE_PRICE_ID=""

# Live Stripe keys (sk_live_/rk_live_) are refused unless this is "true". Leave unset until
# production billing is approved.
# STRIPE_ALLOW_LIVE="false"

# Labeled demo deployments only: show sample dashboard data (with a banner) when the database is
# unavailable. Never set on staging or production.
# NEXT_PUBLIC_DEMO_MODE="false"

# Browser tests only: point the Stripe SDK at the local stand-in (e2e/stripe-standin.mjs).
# Ignored unless STRIPE_SECRET_KEY is a test key. Never set on staging or production.
# STRIPE_API_BASE="http://127.0.0.1:12211"

# Optional: Customer Portal configuration created by `npm run sandbox:setup` (bpc_...). Without it, the
# Stripe account's default portal configuration is used.
# STRIPE_PORTAL_CONFIGURATION_ID=""
